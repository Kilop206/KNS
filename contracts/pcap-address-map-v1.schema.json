{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/pcap-address-map-v1.schema.json",
  "title": "KNS explicit PCAP IPv4-to-model-node mapping v1", "type": "object", "additionalProperties": false,

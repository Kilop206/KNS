{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/topology-v1.schema.json",
  "title": "KNS Topology v1",
  "description": "Portable topology shape. Consumers also enforce graph-wide invariants such as valid endpoints and supported node limits.",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "links"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "description": "Topology wire schema version, independent of application releases.",
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "description": "Legacy node count or typed snapshot-local node list. Product-specific graph limits still apply.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "description": "Non-negative snapshot-local node identifier; link endpoints refer to this value.",
                "type": "integer",
                "minimum": 0
              },
              "external_id": {
                "description": "Stable reconciliation identity across discovery snapshots when available.",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "unknown",
                  "computer",
                  "router",
                  "switch",
                  "access_point",
                  "server",
                  "phone",
                  "printer",
                  "iot",
                  "network_segment"
                ]
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "string"
              },
              "position": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "bandwidth",
          "delay",
          "loss"
        ],
        "additionalProperties": true,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "bandwidth": {
            "description": "Link capacity in megabits per second (Mbps).",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "delay": {
            "description": "One-way propagation delay in milliseconds (ms).",
            "type": "number",
            "minimum": 0
          },
          "loss": {
            "description": "Packet loss probability as a fraction in [0, 1], not a percent.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "full_duplex",
              "half_duplex",
              "simplex"
            ]
          },
          "queue_capacity": {
            "description": "Maximum queued packets; applied per direction for full duplex and shared for half duplex.",
            "type": "integer",
            "minimum": 1
          },
          "inferred": {
            "description": "True for inferred adjacency; does not claim a verified physical link.",
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          },
          "queue_policy": {
            "type": "string",
            "enum": [
              "drop_tail",
              "red"
            ]
          },
          "red_min_threshold": {
            "type": "integer",
            "minimum": 0
          },
          "red_max_threshold": {
            "type": "integer",
            "minimum": 1
          },
          "red_queue_weight": {
            "description": "Dimensionless RED EWMA queue weight in (0, 1].",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 1
          },
          "red_max_drop_probability": {
            "description": "Maximum RED early-drop probability as a fraction in [0, 1].",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "queue_policy": {
                  "const": "red"
                }
              },
              "required": [
                "queue_policy"
              ]
            },
            "then": {
              "required": [
                "red_min_threshold",
                "red_max_threshold",
                "red_max_drop_probability"
              ]
            }
          }
        ]
      }
    }
  }
}

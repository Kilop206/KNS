{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/pcap-address-map-v1.1.schema.json",
  "title": "KNS explicit PCAP IP-to-model-node mapping v1.1",
  "description": "Runtime also checks canonical unscoped spelling, at most 4096 combined entries, and node existence.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version"],
  "anyOf": [{"required": ["ipv4_to_node"]}, {"required": ["ipv6_to_node"]}],
  "properties": {
    "schema_version": {"const": "1.1"},
    "ipv4_to_node": {"type": "object", "minProperties": 1, "maxProperties": 4096,
      "propertyNames": {"format": "ipv4"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
    "ipv6_to_node": {"type": "object", "minProperties": 1, "maxProperties": 4096,
      "propertyNames": {"format": "ipv6", "pattern": "^[^%]+$"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2147483647}}
  }
}

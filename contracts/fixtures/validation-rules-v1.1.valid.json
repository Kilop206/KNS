{
  "schema_version": "1.1",
  "assertions": [
    {
      "name": "delivery-baseline",
      "metric": "delivery_ratio",
      "operator": ">=",
      "baseline_offset": -0.01
    },
    {
      "name": "no-pending-packets",
      "metric": "pending",
      "operator": "==",
      "value": 0
    }
  ]
}

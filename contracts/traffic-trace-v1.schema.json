{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/traffic-trace-v1.schema.json",
  "title": "KNS explicit modeled packet metadata trace v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "packets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packets": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["time_s", "flow_id", "source", "destination", "wire_bytes"],
      "properties": {
        "time_s": {"type": "number", "minimum": -1000000000000000000, "maximum": 1000000000000000000},
        "flow_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "integer"}]},
        "source": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "destination": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "wire_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }}
  }
}

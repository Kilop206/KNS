{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kilop206/KNS/main/contracts/discovery-diff-v1.schema.json",
  "title": "KNS Discovery Snapshot Diff v1",
  "description": "An initial observation contains additions only. Consumers also enforce disjoint added, removed and changed identity sets separately for nodes and links.",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_available"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "baseline_available": {
      "type": "boolean"
    },
    "added_nodes": {
      "$ref": "#/$defs/identity_list"
    },
    "removed_nodes": {
      "$ref": "#/$defs/identity_list"
    },
    "changed_nodes": {
      "$ref": "#/$defs/identity_list"
    },
    "added_links": {
      "$ref": "#/$defs/identity_list"
    },
    "removed_links": {
      "$ref": "#/$defs/identity_list"
    },
    "changed_links": {
      "$ref": "#/$defs/identity_list"
    }
  },
  "if": {"properties": {"baseline_available": {"const": false}}},
  "then": {
    "properties": {
      "removed_nodes": {"maxItems": 0},
      "changed_nodes": {"maxItems": 0},
      "removed_links": {"maxItems": 0},
      "changed_links": {"maxItems": 0}
    }
  },
  "$defs": {
    "identity_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}

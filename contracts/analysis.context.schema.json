{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/analysis-context-v1.schema.json",
  "title": "KNS Analysis Context v1",
  "description": "Deterministic structural analysis produced by KNS AIContextBuilder. Values describe the simulated topology and routing model; they are not observed network measurements or generated claims.",
  "type": "object",
  "required": ["schema_version", "context_type", "depth", "network", "routing", "performance", "structural_risks", "critical_nodes", "critical_links", "findings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_type": {"const": "kns_ai_context"},
    "depth": {"enum": ["quick", "detailed", "deep"]},
    "network": {
      "type": "object",
      "required": ["node_count", "link_count", "connected", "connected_components"],
      "properties": {
        "node_count": {"type": "integer", "minimum": 0},
        "link_count": {"type": "integer", "minimum": 0},
        "connected": {"type": "boolean"},
        "connected_components": {"type": "integer", "minimum": 0}
      }
    },
    "routing": {
      "type": "object",
      "required": ["reachable_routes", "unreachable_routes", "average_hop_count", "maximum_hop_count", "average_routing_distance", "maximum_routing_distance"],
      "properties": {
        "reachable_routes": {"type": "integer", "minimum": 0},
        "unreachable_routes": {"type": "integer", "minimum": 0},
        "average_hop_count": {"type": "number", "minimum": 0},
        "maximum_hop_count": {"type": "integer", "minimum": 0},
        "average_routing_distance": {"type": "number"},
        "maximum_routing_distance": {"type": "number"}
      }
    },
    "performance": {
      "type": "object",
      "required": ["average_path_delay_ms", "maximum_path_delay_ms", "average_bottleneck_bandwidth_mbps", "minimum_bottleneck_bandwidth_mbps"],
      "properties": {
        "average_path_delay_ms": {"type": "number", "minimum": 0, "description": "Mean modeled path propagation delay in milliseconds."},
        "maximum_path_delay_ms": {"type": "number", "minimum": 0, "description": "Maximum modeled path propagation delay in milliseconds."},
        "average_bottleneck_bandwidth_mbps": {"type": "number", "minimum": 0, "description": "Mean modeled route bottleneck capacity in Mbps."},
        "minimum_bottleneck_bandwidth_mbps": {"type": "number", "minimum": 0, "description": "Minimum modeled route bottleneck capacity in Mbps."}
      }
    },
    "structural_risks": {
      "type": "object",
      "required": ["isolated_nodes", "articulation_points", "bridge_count"],
      "properties": {
        "isolated_nodes": {"$ref": "#/$defs/nodeIds"},
        "articulation_points": {"$ref": "#/$defs/nodeIds"},
        "bridge_count": {"type": "integer", "minimum": 0}
      }
    },
    "critical_nodes": {"type": "array", "items": {"type": "object"}, "description": "Bounded list; absence from this list does not prove a node is safe."},
    "critical_links": {"type": "array", "items": {"type": "object"}, "description": "Bounded list; absence from this list does not prove a link is safe."},
    "findings": {"type": "array", "items": {"type": "object"}, "description": "Findings computed by KNS, not generated by a language model."},
    "worst_routes": {"type": "array", "items": {"type": "object"}},
    "unreachable_routes": {"type": "array", "items": {"type": "object"}},
    "all_structural_bridges": {"type": "array", "items": {"$ref": "#/$defs/linkEndpoints"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "nodeIds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "linkEndpoints": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "integer", "minimum": 0},
        "to": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://userex.dev/contracts/kns/capacity-costs-v1.schema.json",
  "title": "KNS user-declared capacity alternative costs v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "currency", "uplinks"],
  "properties": {
    "schema_version": {"const": "1.0"}, "currency": {"type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9]+$"},
    "sensor_unit_cost": {"type": "number", "minimum": 0, "maximum": 1000000000000000},
    "uplinks": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["bandwidth_mbps", "cost"],
      "properties": {"bandwidth_mbps": {"type": "number", "minimum": 0.000000001, "maximum": 1000000000},
                     "cost": {"type": "number", "minimum": 0, "maximum": 1000000000000000}}
    }}
  }
}
